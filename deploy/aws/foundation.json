{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Dynamic AI World Cup single-host foundation. Existing VPC/subnet; no ALB, NAT, RDS, domain or secrets.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Existing subnet with IPv4 Internet Gateway egress; verify its AZ matches SubnetAz."
    },
    "SubnetAz": {
      "Type": "AWS::EC2::AvailabilityZone::Name"
    },
    "AmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Verified Amazon Linux 2023 x86_64 AMI; root device /dev/xvda. No unpinned AMI lookup."
    },
    "CloudFrontPrefixListId": {
      "Type": "String",
      "AllowedPattern": "^pl-[0-9a-f]+$",
      "Description": "Region's com.amazonaws.global.cloudfront.origin-facing managed prefix list."
    },
    "CloudFrontServiceSecurityGroupId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^sg-[0-9a-f]+$",
      "Description": "Leave empty until VPC origin is deployed; then set AWS-created CloudFront-VPCOrigins-Service-SG ID to replace prefix-list ingress."
    }
  },
  "Conditions": {
    "UseCloudFrontServiceGroup": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CloudFrontServiceSecurityGroupId"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "AppSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "World Cup origin: CloudFront HTTP only; no SSH, application or PostgreSQL ingress.",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "Fn::If": [
              "UseCloudFrontServiceGroup",
              {
                "IpProtocol": "tcp",
                "FromPort": 80,
                "ToPort": 80,
                "SourceSecurityGroupId": {
                  "Ref": "CloudFrontServiceSecurityGroupId"
                },
                "Description": "CloudFront VPC origin service group"
              },
              {
                "IpProtocol": "tcp",
                "FromPort": 80,
                "ToPort": 80,
                "SourcePrefixListId": {
                  "Ref": "CloudFrontPrefixListId"
                },
                "Description": "Bootstrap CloudFront origin-facing prefix list"
              }
            ]
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "HTTPS package, SSM, ECR, S3 and provider egress"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "dynamic-ai-world-cup"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-app"
            }
          }
        ]
      }
    },
    "ImageRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "dynamic-ai-world-cup"
          }
        ]
      }
    },
    "ArtifactBackupBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "dynamic-ai-world-cup"
          }
        ]
      }
    },
    "ArtifactBackupBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ArtifactBackupBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ArtifactBackupBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ArtifactBackupBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "WorldCupRuntimeOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "EcrAuthentication",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "PullOwnImages",
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ImageRepository",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "WriteBackupsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ArtifactBackupBucket.Arn}/backups/*"
                  }
                },
                {
                  "Sid": "ListBackupsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ArtifactBackupBucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "backups/",
                        "backups/*"
                      ]
                    }
                  }
                },
                {
                  "Sid": "ReadRuntimeArtifactsOnly",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ArtifactBackupBucket.Arn}/artifacts/*"
                  }
                },
                {
                  "Sid": "ReadWorldCupParameters",
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/worldcup/production/*"
                  }
                },
                {
                  "Sid": "DenyOtherParameterReads",
                  "Effect": "Deny",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters",
                    "ssm:GetParametersByPath",
                    "ssm:GetParameterHistory"
                  ],
                  "NotResource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/worldcup/production/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "dynamic-ai-world-cup"
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "AppInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": "t3.small",
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "DisableApiTermination": true,
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "MetadataOptions": {
          "HttpEndpoint": "enabled",
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1,
          "InstanceMetadataTags": "disabled"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "DeleteOnTermination": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Ref": "AppSecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 20,
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\ndnf install -y docker amazon-ssm-agent\nsystemctl enable --now docker\nsystemctl enable --now amazon-ssm-agent\n"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "dynamic-ai-world-cup"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-app"
            }
          }
        ]
      }
    },
    "DatabaseVolume": {
      "Type": "AWS::EC2::Volume",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "AvailabilityZone": {
          "Ref": "SubnetAz"
        },
        "Size": 8,
        "VolumeType": "gp3",
        "Encrypted": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "dynamic-ai-world-cup"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-postgres"
            }
          }
        ]
      }
    },
    "DatabaseVolumeAttachment": {
      "Type": "AWS::EC2::VolumeAttachment",
      "Properties": {
        "Device": "/dev/sdf",
        "InstanceId": {
          "Ref": "AppInstance"
        },
        "VolumeId": {
          "Ref": "DatabaseVolume"
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "AppInstance"
      }
    },
    "InstanceArn": {
      "Value": {
        "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${AppInstance}"
      }
    },
    "InstancePrivateDnsName": {
      "Value": {
        "Fn::GetAtt": [
          "AppInstance",
          "PrivateDnsName"
        ]
      }
    },
    "InstanceSecurityGroupId": {
      "Value": {
        "Ref": "AppSecurityGroup"
      }
    },
    "DatabaseVolumeId": {
      "Value": {
        "Ref": "DatabaseVolume"
      }
    },
    "ImageRepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "ImageRepository",
          "RepositoryUri"
        ]
      }
    },
    "ArtifactBackupBucketName": {
      "Value": {
        "Ref": "ArtifactBackupBucket"
      }
    },
    "InstanceRoleName": {
      "Value": {
        "Ref": "InstanceRole"
      }
    }
  }
}
