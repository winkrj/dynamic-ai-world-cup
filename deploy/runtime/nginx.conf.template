worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 1m;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 20s;
    server {
        listen 8080 default_server;
        server_name _;
        # Also restrict EC2 ingress to this CloudFront VPC origin's service SG.
        if ($http_x_origin_verify != "${ORIGIN_VERIFY_TOKEN}") { return 403; }
        if ($http_x_forwarded_for = "") { return 403; }
        location / {
            proxy_pass http://172.30.52.3:8080;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host "${PUBLIC_HOST}";
            # CloudFront appends the viewer IP to the RIGHT. Do not append the
            # edge peer here: Tomcat trusts only nginx and selects that viewer IP.
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header X-Real-IP "";
            proxy_set_header X-Origin-Verify "";
            proxy_connect_timeout 5s;
            proxy_read_timeout 30s;
            proxy_send_timeout 30s;
            proxy_intercept_errors off;
        }
    }
}
