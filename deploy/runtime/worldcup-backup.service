[Unit]
Description=World Cup database-only backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/worldcup

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /opt/worldcup/runtime/backup.sh /etc/worldcup/runtime.env
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/worldcup/backups

