# Copy outside Git to /etc/worldcup/runtime.env with owner root and mode 600.
# These placeholders intentionally fail validation. Resolve linux/amd64 digests.
APP_IMAGE=REPLACE_WITH_ECR_REPOSITORY@sha256:REPLACE_WITH_RELEASE_DIGEST
NGINX_IMAGE=nginx:stable-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
POSTGRES_IMAGE=postgres:17-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
PUBLIC_HOST=REPLACE_WITH_DISTRIBUTION.cloudfront.net
BACKUP_BUCKET=REPLACE_WITH_PRIVATE_BACKUP_BUCKET
AWS_REGION=ap-northeast-2
# This installation's cumulative allowance, NOT a daily/monthly reset.
# Use 0 throughout restore/reconciliation; only 5 is approved for public operation.
CANDIDATE_BUDGET_USD=5
# Explicit opt-in after deploying a compatible image; staged is the rollback.
# Older runtime.env files that omit both settings retain staged / 30.
CANDIDATE_ENGINE_STRATEGY=catalog
CANDIDATE_FAST_TIMEOUT_SECONDS=30
# 2 = normal daily cap; 0 = user-approved judging period without a daily cap.
# Burst/IP protection, accounting and cumulative AI budget remain enabled.
# Omission retains 2. Change only with a compatible app image, then redeploy.
GENERATION_DAILY_LIMIT=2
