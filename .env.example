# Documentation template: Spring reads exported variables, not this file automatically.
# Local synthetic mode: ./gradlew bootRun --args='--spring.profiles.active=dev'
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:55432/worldcup
DATABASE_USERNAME=worldcup
# Only for the local compose database; not a production secret.
DATABASE_PASSWORD=worldcup-local-only
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Default/prod requires your own database credentials and an HTTPS PUBLIC_ORIGIN.
# Actual AI: explicit live profile; never combine dev and live.
# Keep OPENAI_API_KEY in server environment/secret storage, never in frontend or Git.
# OPENAI_API_KEY=
# CANDIDATE_MODEL=gpt-5.6-terra
# CANDIDATE_REVIEW_MODEL=gpt-5.6-terra
# CANDIDATE_BUDGET_USD=0
# Budget is cumulative for this database, not a monthly reset or a provider billing hard cap.
# See docs/CANDIDATE_ENGINE.md for local live startup and paid evaluation.
