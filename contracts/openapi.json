{
  "openapi": "3.1.0",
  "info": {
    "title": "Dynamic AI World Cup API",
    "version": "1.0.0",
    "description": "Backend endpoints are implemented on the server/engine branches; main may lag until integration. See docs/API_CONTRACT.md for ownership, idempotency and cross-field invariants, and docs/INTEGRATION_SPEC.md for UI integration. Endpoint implementation does not imply candidate-quality or frontend completion."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "get health",
        "x-implementation-status": "implemented",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; HTTP status semantics in docs/API_CONTRACT.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
