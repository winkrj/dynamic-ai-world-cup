{
  "name": "dynamic-ai-world-cup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev:web": "vite --config frontend/vite.config.ts frontend",
    "build:web": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts frontend",
    "package:app": "npm run build:web && cd backend && ./gradlew --no-daemon appJar",
    "contracts:generate": "openapi-typescript contracts/openapi.json -o frontend/src/api/schema.d.ts",
    "contracts:check": "node scripts/check-contracts.mjs",
    "api:smoke": "node scripts/smoke-api.mjs",
    "test:handoff": "node --test scripts/smoke-api.test.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
